<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Theme -->
    <style name="Theme.NoteBlocked" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Couleurs principales sombres -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Couleurs secondaires -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <!-- Couleur de fond -->
        <item name="android:windowBackground">@color/colorWindowBackground</item>

        <!-- Affichage bord à bord (edge-to-edge) géré via EdgeToEdge.enable() et les insets.
             android:statusBarColor est déprécié depuis Android 15 (SDK 35) et a été retiré. -->
    </style>

    <style name="Theme.NoteBlock.NoActionBar" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Désactive la barre d'action fournie par le système -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:windowBackground">@color/colorWindowBackground</item>
    </style>
</resources>
