<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Zone de saisie scrollable : occupe toute la hauteur disponible au-dessus des boutons -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/edit_note_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/edit_note_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Titre de la note -->
            <EditText
                android:id="@+id/edit_note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="@string/title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:ellipsize="end"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:importantForAutofill="no" />

            <!-- Séparateur discret entre le titre et le contenu -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="#E0E0E0" />

            <!-- Contenu de la note : occupe l'espace restant, interligne confortable -->
            <EditText
                android:id="@+id/edit_note_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="@string/note_content"
                android:textSize="17sp"
                android:lineSpacingMultiplier="1.35"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="8"
                android:importantForAutofill="no" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Séparateur au-dessus de la barre d'actions -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- Barre d'actions fixe : reste toujours sous le contenu -->
    <LinearLayout
        android:id="@+id/fab_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Partager -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share"
                android:textSize="16sp"
                android:paddingEnd="8dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_share"
                app:backgroundTint="@android:color/holo_green_light"
                app:tint="@android:color/white"
                android:contentDescription="@string/share" />
        </LinearLayout>

        <!-- Supprimer -->
        <LinearLayout
            android:id="@+id/ll_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:textSize="16sp"
                android:paddingEnd="8dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_delete"
                app:backgroundTint="@android:color/holo_red_light"
                app:tint="@android:color/white"
                android:contentDescription="@string/delete" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
